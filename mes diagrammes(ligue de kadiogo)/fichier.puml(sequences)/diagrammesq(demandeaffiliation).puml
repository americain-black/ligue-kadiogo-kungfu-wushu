@startuml "Soumettre une demande d'affiliation"

participant "Gestionnaire Club" as GC
participant "Gestionnaire Financier" as GF
participant "Gestionnaire Ligue" as GL
participant "Système" as SYS
participant "Base de données" as DB

== Soumission de la demande ==

GC -> SYS : 1. Accéder au formulaire d'affiliation (HTTP GET)
SYS --> GC : 2. Afficher le formulaire structuré

GC -> SYS : 3. Remplir et soumettre le formulaire (HTTP POST)
SYS -> SYS : 4. Vérifier la complétude des données

alt Champs obligatoires manquants ou invalides
    SYS --> GC : 5. Signaler les erreurs — reprendre à l'étape 3
else Données valides

    SYS -> DB : 6. DemandeAffiliation.soumettre()\n→ statut EN_ATTENTE_PAIEMENT
    SYS --> GC : 7. Notifier le montant des frais d'affiliation

    == Paiement des frais ==

    GC -> SYS : 8. Effectuer le paiement et transmettre la preuve (HTTP POST)
    SYS -> DB : 9. Enregistrer PaiementAffiliation (statut EN_ATTENTE)\nDemandeAffiliation → EN_ATTENTE_VALID_FINANCIER
    SYS --> GF : 10. Notifier un paiement à vérifier

    == Validation financière ==

    GF -> SYS : 11. Consulter la preuve de paiement (HTTP GET)
    GF -> SYS : 12. Vérifier la conformité

    alt Preuve illisible ou montant incorrect
        GF -> SYS : 13. Rejeter la preuve avec motif (HTTP POST)
        SYS -> DB : 14. PaiementAffiliation.rejeter()\n→ statut REJETE\nDemandeAffiliation → EN_ATTENTE_PAIEMENT
        SYS --> GC : 15. Notifier le rejet et le motif
        GC -> SYS : 16. Transmettre une nouvelle preuve — reprendre à l'étape 8

    else Preuve conforme

        GF -> SYS : 17. Valider le paiement (HTTP POST)
        SYS -> DB : 18. PaiementAffiliation.valider()\n→ statut VALIDE\nDemandeAffiliation → EN_ATTENTE_VALID_LIGUE
        SYS --> GL : 19. Notifier le dossier à examiner

        == Validation par la Ligue ==

        GL -> SYS : 20. Consulter le dossier complet (HTTP GET)

        alt Demande rejetée par la Ligue
            GL -> SYS : 21. Saisir le motif du rejet (HTTP POST)
            SYS -> DB : 22. DemandeAffiliation.rejeter_par_ligue()\n→ statut REJETEE
            SYS --> GC : 23. Notifier le rejet — modification possible

        else Demande approuvée

            GL -> SYS : 24. Approuver la demande (HTTP POST)
            SYS -> DB : 25. DemandeAffiliation.approuver()\n→ statut APPROUVEE\nClub.statut_club → AFFILIE
            SYS --> GC : 26. Notifier l'affiliation confirmée

        end
    end
end

@enduml
