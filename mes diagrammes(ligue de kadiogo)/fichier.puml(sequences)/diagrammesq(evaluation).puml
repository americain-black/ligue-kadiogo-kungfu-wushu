@startuml "Évaluer un candidat - Saisie et validation des notes"

participant "Jury" as J
participant "Gestionnaire Ligue" as GL
participant "Système (Daphne/Channels)" as SYS
participant "Base de données" as DB

== Connexion WebSocket ==

J -> SYS : 1. Connexion WebSocket\nws/evaluations/session/{id}/notation/
SYS --> J : 2. Connexion établie — rejoint groupe session_{id}

GL -> SYS : 3. Connexion WebSocket\nws/evaluations/session/{id}/notation/
SYS --> GL : 4. Connexion établie — rejoint groupe session_{id}

== Saisie des notes ==

J -> SYS : 5. Accéder à l'interface de notation (HTTP GET)
SYS --> J : 6. Afficher la liste des candidats autorisés

J -> SYS : 7. Sélectionner le candidat à évaluer (HTTP GET)
SYS --> J : 8. Afficher la fiche candidat et la grille de notation

J -> SYS : 9. Saisir les notes par critère (HTTP POST /saisir/)
SYS -> DB : 10. Enregistrer NoteRubrique (note, validée=False)
SYS -> SYS : 11. group_send session_{id} → note_saisie
SYS --> GL : 12. [WS] Mise à jour note en temps réel

J -> SYS : 13. Valider les notes (HTTP POST /valider/)

alt Correction d'une note déjà validée
    J -> GL : 14. Demander autorisation de correction
    GL -> SYS : 15. Déverrouiller la note (HTTP POST /deverrouiller/)
    SYS -> DB : 16. note.validee = False, correction_demandee = False
    SYS -> SYS : 17. group_send session_{id} → note_deverrouillee
    SYS --> J : 18. [WS] Note déverrouillée — reprendre à l'étape 9
else Notes validées

    SYS -> DB : 19. note.valider() → validee = True
    SYS -> SYS : 20. group_send session_{id} → note_saisie (validee=True)
    SYS --> GL : 21. [WS] Note validée en temps réel

    SYS -> SYS : 22. Vérifier que toutes les rubriques ont une note validée

    alt Notes manquantes (rubriques sans note)
        SYS -> SYS : 23. Suspendre le calcul du résultat
        SYS -> SYS : 24. group_send session_{id} → notes_manquantes
        SYS --> GL : 25. [WS] Afficher rubriques manquantes

    else Toutes les notes reçues

        SYS -> SYS : 26. Resultat.calculer(inscription)
        SYS -> DB : 27. Calculer moyenne pondérée

        alt Note éliminatoire détectée (note < note_minimale)
            SYS -> DB : 28. Enregistrer decision = AJOURNÉ
        else Aucune note éliminatoire
            SYS -> DB : 29. Enregistrer decision = ADMIS ou AJOURNÉ
        end

        SYS -> SYS : 30. group_send session_{id} → resultat_calcule
        SYS --> GL : 31. [WS] Afficher résultat en temps réel

    end
end

@enduml
